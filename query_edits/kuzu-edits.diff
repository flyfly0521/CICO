--- a/Kuzu/queries/baseline/ldbc-bi/bi-2.cypher
+++ b/Kuzu/queries/baseline/ldbc-bi/bi-2.cypher
@@ -1,18 +1,19 @@
 // Q2. Tag evolution
 // Kuzu adaptation: Message is represented by the POST:COMMENT union.
 // Kuzu 0.10 needs the parameter-derived window boundaries materialized with explicit TIMESTAMP casts.
-WITH
-  CAST($date, 'TIMESTAMP') AS windowStart,
-  CAST($date, 'TIMESTAMP') + duration('100 days') AS windowMiddle,
-  CAST($date, 'TIMESTAMP') + duration('200 days') AS windowEnd
+// Query edit (IncGQ middleware): the three window boundaries are written into the
+// predicates instead of being bound by a leading WITH. They are deterministic
+// expressions of $date and the leading WITH yields exactly one row, so substituting
+// them changes nothing; with $date specialized they fold to the TIMESTAMP literals
+// the parameter-dependent FILLs use (cf. Kuzu/queries/optimized/ldbc-bi/bi-2.cypher).
 MATCH (tag:TAG)-[:HASTYPE]->(:TAGCLASS {name: $tagClass})
 OPTIONAL MATCH (message1:POST:COMMENT)-[:HASTAG]->(tag)
-  WHERE windowStart <= message1.creationDate
-    AND message1.creationDate < windowMiddle
-WITH tag, windowMiddle, windowEnd, count(message1) AS countWindow1
+  WHERE CAST($date, 'TIMESTAMP') <= message1.creationDate
+    AND message1.creationDate < CAST($date, 'TIMESTAMP') + duration('100 days')
+WITH tag, count(message1) AS countWindow1
 OPTIONAL MATCH (message2:POST:COMMENT)-[:HASTAG]->(tag)
-  WHERE windowMiddle <= message2.creationDate
-    AND message2.creationDate < windowEnd
+  WHERE CAST($date, 'TIMESTAMP') + duration('100 days') <= message2.creationDate
+    AND message2.creationDate < CAST($date, 'TIMESTAMP') + duration('200 days')
 WITH tag, countWindow1, count(message2) AS countWindow2
 RETURN
   tag.name AS name,
--- a/Kuzu/queries/baseline/ldbc-bi/bi-4.cypher
+++ b/Kuzu/queries/baseline/ldbc-bi/bi-4.cypher
@@ -12,10 +12,16 @@
 UNWIND topForums AS memberForum
 MATCH (person:PERSON)<-[:HASMEMBER]-(memberForum)
 WITH DISTINCT topForums, person
+// Same result as OPTIONAL MATCH ... (rootForum:FORUM) WHERE rootForum IN topForums:
+// every row has a non-empty topForums (person comes from UNWIND topForums), FORUM.id
+// is the primary key, and count(DISTINCT message) ignores the per-forum duplication.
+// Written per forum so that the index rewrite stays inside one QueryPart (IncGQ
+// middleware); Kuzu cannot bind an unwound node in a pattern, hence the id.
+UNWIND topForums AS topForum
+WITH person, topForum.id AS rootForumId
 OPTIONAL MATCH
   (person)<-[:HASCREATOR]-(message:POST:COMMENT)-[:REPLYOF*0..]->
-  (post:POST)<-[:CONTAINEROF]-(rootForum:FORUM)
-WHERE rootForum IN topForums
+  (post:POST)<-[:CONTAINEROF]-(rootForum:FORUM {id: rootForumId})
 WITH person, count(DISTINCT message) AS messageCount
 RETURN
   person.id AS personId,
--- a/Kuzu/queries/baseline/ldbc-bi/bi-6.cypher
+++ b/Kuzu/queries/baseline/ldbc-bi/bi-6.cypher
@@ -1,10 +1,20 @@
 // Q6. Most authoritative users on a given topic
 // Kuzu adaptation: Message is represented by the POST:COMMENT union.
+// Query edit (IncGQ middleware), the structure of the LDBC reference query
+// (Neo4j bi-6: WITH DISTINCT person1, person2 CALL (person2) {...} sum(likerScore)):
+// count(DISTINCT like) per person1 = sum over its DISTINCT likers person2 of the
+// likes on person2's messages, because every like edge ends at one message and
+// every message has at most one creator (LDBC data model; checked on the store),
+// so the like sets of different person2 are disjoint. count(person3) equals
+// count(like): in the OPTIONAL MATCH both are non-null together. A NULL person2
+// contributes 0, as in the original.
 MATCH (tag:TAG {name: $tag})<-[:HASTAG]-(message1:POST:COMMENT)-[:HASCREATOR]->(person1:PERSON)
 OPTIONAL MATCH (message1)<-[:LIKES]-(person2:PERSON)
+WITH DISTINCT person1, person2
 OPTIONAL MATCH (person2)<-[:HASCREATOR]-(message2:POST:COMMENT)<-[like:LIKES]-(person3:PERSON)
+WITH person1, person2, count(person3) AS likerScore
 RETURN
   person1.id AS personId,
-  count(DISTINCT like) AS authorityScore
+  sum(likerScore) AS authorityScore
 ORDER BY authorityScore DESC, personId ASC
 LIMIT 100
--- a/Kuzu/queries/baseline/ldbc-bi/bi-16.cypher
+++ b/Kuzu/queries/baseline/ldbc-bi/bi-16.cypher
@@ -1,21 +1,42 @@
 // Q16. Fake news detection
 // Kuzu adaptation: replaces Neo4j CALL subquery with explicit A/B branches in a single pipeline.
+// Query edit (IncGQ middleware), two steps that keep the result:
+// 1. The day test CAST(CAST(m.creationDate AS TIMESTAMP) AS DATE) = CAST($dateX AS DATE)
+//    is written as the half-open interval [date_trunc('day', $dateX), +1 day): for a
+//    TIMESTAMP creationDate and a TIMESTAMP parameter (the runner passes datetime) the
+//    two are the same condition. With $dateX specialized the bounds fold to the
+//    TIMESTAMP literals of the parameter-dependent FILLs. (Kuzu rejects the nested
+//    CAST(CAST($dateX AS DATE) AS TIMESTAMP) when $dateX occurs in several clauses.)
+// 2. count(DISTINCT friendX) over friends with a matching message is computed per friend:
+//    group the friend's matching messages, then count the distinct friends whose count
+//    is positive (cf. Kuzu/queries/optimized/ldbc-bi/bi-16.cypher). A missing friend
+//    or a friend without such a message contributes NULL, which count(DISTINCT) skips.
 MATCH (person1:PERSON)
 OPTIONAL MATCH (person1)<-[:HASCREATOR]-(messageA:POST:COMMENT)-[:HASTAG]->(:TAG {name: $tagA})
-WHERE CAST(CAST(messageA.creationDate AS TIMESTAMP) AS DATE) = CAST($dateA AS DATE)
+WHERE date_trunc('day', $dateA) <= messageA.creationDate
+  AND messageA.creationDate < date_trunc('day', $dateA) + duration('1 day')
 WITH person1, count(DISTINCT messageA) AS messageCountA
 WHERE messageCountA > 0
-OPTIONAL MATCH (person1)-[:KNOWS]-(friendA:PERSON)<-[:HASCREATOR]-(friendMessageA:POST:COMMENT)-[:HASTAG]->(:TAG {name: $tagA})
-WHERE CAST(CAST(friendMessageA.creationDate AS TIMESTAMP) AS DATE) = CAST($dateA AS DATE)
-WITH person1, messageCountA, count(DISTINCT friendA) AS friendCountA
+OPTIONAL MATCH (person1)-[:KNOWS]-(friendA:PERSON)
+WITH person1, messageCountA, friendA
+OPTIONAL MATCH (friendA)<-[:HASCREATOR]-(friendMessageA:POST:COMMENT)-[:HASTAG]->(:TAG {name: $tagA})
+WHERE date_trunc('day', $dateA) <= friendMessageA.creationDate
+  AND friendMessageA.creationDate < date_trunc('day', $dateA) + duration('1 day')
+WITH person1, messageCountA, friendA, count(DISTINCT friendMessageA) AS friendMessageCountA
+WITH person1, messageCountA, count(DISTINCT CASE WHEN friendMessageCountA > 0 THEN friendA.id END) AS friendCountA
 WHERE friendCountA <= $maxKnowsLimit
 OPTIONAL MATCH (person1)<-[:HASCREATOR]-(messageB:POST:COMMENT)-[:HASTAG]->(:TAG {name: $tagB})
-WHERE CAST(CAST(messageB.creationDate AS TIMESTAMP) AS DATE) = CAST($dateB AS DATE)
+WHERE date_trunc('day', $dateB) <= messageB.creationDate
+  AND messageB.creationDate < date_trunc('day', $dateB) + duration('1 day')
 WITH person1, messageCountA, count(DISTINCT messageB) AS messageCountB
 WHERE messageCountB > 0
-OPTIONAL MATCH (person1)-[:KNOWS]-(friendB:PERSON)<-[:HASCREATOR]-(friendMessageB:POST:COMMENT)-[:HASTAG]->(:TAG {name: $tagB})
-WHERE CAST(CAST(friendMessageB.creationDate AS TIMESTAMP) AS DATE) = CAST($dateB AS DATE)
-WITH person1, messageCountA, messageCountB, count(DISTINCT friendB) AS friendCountB
+OPTIONAL MATCH (person1)-[:KNOWS]-(friendB:PERSON)
+WITH person1, messageCountA, messageCountB, friendB
+OPTIONAL MATCH (friendB)<-[:HASCREATOR]-(friendMessageB:POST:COMMENT)-[:HASTAG]->(:TAG {name: $tagB})
+WHERE date_trunc('day', $dateB) <= friendMessageB.creationDate
+  AND friendMessageB.creationDate < date_trunc('day', $dateB) + duration('1 day')
+WITH person1, messageCountA, messageCountB, friendB, count(DISTINCT friendMessageB) AS friendMessageCountB
+WITH person1, messageCountA, messageCountB, count(DISTINCT CASE WHEN friendMessageCountB > 0 THEN friendB.id END) AS friendCountB
 WHERE friendCountB <= $maxKnowsLimit
 RETURN
   person1.id AS personId,
--- a/Kuzu/queries/baseline/lsqb/q4.cypher
+++ b/Kuzu/queries/baseline/lsqb/q4.cypher
@@ -1,14 +1,16 @@
+// One QueryPart per label branch of the original count{} + count{}:
+// part 1 counts the Post branch; part 2 counts the Comment branch with
+// OPTIONAL MATCH + count(message), which is 0 without a match (as count{}).
+// MATCH (d:Person) ... LIMIT 1 keeps the original row semantics (one row iff
+// Person is non-empty).
+MATCH (:Tag)<-[:Post_hasTag_Tag]-(message:Post)-[:Post_hasCreator_Person]->(creator:Person),
+  (message)<-[:Person_likes_Post]-(liker:Person),
+  (message)<-[:Comment_replyOf_Post]-(comment:Comment)
+WITH count(*) AS postCount
+OPTIONAL MATCH (:Tag)<-[:Comment_hasTag_Tag]-(message:Comment)-[:Comment_hasCreator_Person]->(creator:Person),
+  (message)<-[:Person_likes_Comment]-(liker:Person),
+  (message)<-[:Comment_replyOf_Comment]-(comment:Comment)
+WITH postCount, count(message) AS commentCount
 MATCH (d:Person)
-WITH d LIMIT 1
-RETURN
-  count {
-    MATCH (:Tag)<-[:Post_hasTag_Tag]-(message:Post)-[:Post_hasCreator_Person]->(creator:Person),
-      (message)<-[:Person_likes_Post]-(liker:Person),
-      (message)<-[:Comment_replyOf_Post]-(comment:Comment)
-  }
-  +
-  count {
-    MATCH (:Tag)<-[:Comment_hasTag_Tag]-(message:Comment)-[:Comment_hasCreator_Person]->(creator:Person),
-      (message)<-[:Person_likes_Comment]-(liker:Person),
-      (message)<-[:Comment_replyOf_Comment]-(comment:Comment)
-  } AS count
+WITH postCount, commentCount, d LIMIT 1
+RETURN postCount + commentCount AS count
--- a/Kuzu/queries/baseline/lsqb/q8.cypher
+++ b/Kuzu/queries/baseline/lsqb/q8.cypher
@@ -1,14 +1,11 @@
+// Single QueryPart form of the original count{Post branch} + count{Comment branch}:
+// every relationship table has fixed endpoint labels, so the Post:Comment pattern
+// matches exactly the disjoint union of the two branches.  MATCH (d:Person) ...
+// LIMIT 1 keeps the original row semantics (one row iff Person is non-empty).
+MATCH (tag1:Tag)<-[:Post_hasTag_Tag|Comment_hasTag_Tag]-(message:Post:Comment)<-[:Comment_replyOf_Post|Comment_replyOf_Comment]-(comment:Comment)-[:Comment_hasTag_Tag]->(tag2:Tag)
+WHERE NOT EXISTS { MATCH (comment)-[:Comment_hasTag_Tag]->(tag1) }
+  AND tag1 <> tag2
+WITH count(*) AS cnt
 MATCH (d:Person)
-WITH d LIMIT 1
-RETURN
-  count {
-    MATCH (tag1:Tag)<-[:Post_hasTag_Tag]-(message:Post)<-[:Comment_replyOf_Post]-(comment:Comment)-[:Comment_hasTag_Tag]->(tag2:Tag)
-    WHERE NOT (comment)-[:Comment_hasTag_Tag]->(tag1)
-      AND tag1 <> tag2
-  }
-  +
-  count {
-    MATCH (tag1:Tag)<-[:Comment_hasTag_Tag]-(message:Comment)<-[:Comment_replyOf_Comment]-(comment:Comment)-[:Comment_hasTag_Tag]->(tag2:Tag)
-    WHERE NOT (comment)-[:Comment_hasTag_Tag]->(tag1)
-      AND tag1 <> tag2
-  } AS count
+WITH cnt, d LIMIT 1
+RETURN cnt AS count
